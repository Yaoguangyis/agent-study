---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StudySketch from "@/components/StudySketch.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
const posts = getSortedPosts(await getCollection("posts"));
const projects = posts.filter(p => p.data.kind === "project").slice(0, 2);
const notes = posts.filter(p => p.data.kind === "note").slice(0, 4);
const skills = posts.filter(p => p.data.kind === "skill").slice(0, 3);
const url = (path: string) => getRelativeLocaleUrl("zh", path);
---
<Layout>
  <Header />
  <main id="main-content" class="study-home">
    <section class="study-hero" aria-labelledby="intro-title">
      <div>
        <p class="byline">Yaoguangyis 的数字书房 <span>学习 / 实验 / 记录</span></p>
        <h1 id="intro-title">做一点东西，<br />写一些笔记。</h1>
        <p class="hero-copy">这里放 Agent 作品，也记下学习路上的问题、尝试和方法。把散落的想法整理起来，留给下一次动手时的自己。</p>
        <div class="hero-links"><a href={url("projects")}>翻看作品</a><a href={url("posts")}>读一篇笔记</a></div>
      </div>
      <figure class="sketch-wrap"><StudySketch /><figcaption class="sketch-caption">想法在纸上，实践在路上。</figcaption></figure>
    </section>
    <div class="study-body">
      <div>
        <section aria-labelledby="projects-title">
          <div class="section-heading"><h2 id="projects-title">作品选集</h2><a class="quiet-link" href={url("projects")}>全部作品</a></div>
          <div class="project-list">
            {projects.map((p, i) => (
              <article class="project-item">
                <a href={getPostUrl(p.id, p.filePath, "zh")}>
                  <div class="project-image" aria-hidden="true">
                    {i === 0 ? (
                      <svg viewBox="0 0 240 130" fill="none">
                        <rect x="12" y="23" width="53" height="76" rx="3" fill="var(--background)" stroke="currentColor" stroke-opacity=".5"/>
                        <path d="M24 41H53M24 51H48M24 61H53M24 71H44" stroke="currentColor" stroke-opacity=".4"/>
                        <path d="M74 61H106M100 56L106 61L100 66" stroke="currentColor"/>
                        <rect x="118" y="37" width="43" height="47" rx="3" stroke="currentColor"/>
                        <path d="M130 51L138 60L130 69M143 69H150M169 61H194M188 56L194 61L188 66" stroke="currentColor"/>
                        <rect x="203" y="42" width="24" height="37" rx="2" fill="var(--background)" stroke="currentColor"/>
                        <path d="M209 52H221M209 59H221M209 66H216" stroke="currentColor" stroke-opacity=".5"/>
                        <text x="118" y="109" fill="currentColor" font-size="9" font-family="monospace">read · sort · trace</text>
                      </svg>
                    ) : (
                      <svg viewBox="0 0 240 130" fill="none">
                        <path d="M39 35L100 45M40 97L100 66M129 54L194 35M129 64L191 96" stroke="currentColor" stroke-opacity=".3"/>
                        <rect x="16" y="20" width="43" height="31" rx="3" fill="var(--background)" stroke="currentColor"/>
                        <rect x="19" y="81" width="43" height="31" rx="3" fill="var(--background)" stroke="currentColor"/>
                        <rect x="178" y="18" width="43" height="31" rx="3" fill="var(--background)" stroke="currentColor"/>
                        <rect x="178" y="81" width="43" height="31" rx="3" fill="var(--background)" stroke="currentColor"/>
                        <circle cx="113" cy="59" r="22" fill="var(--background)" stroke="currentColor"/>
                        <circle cx="111" cy="57" r="7" stroke="currentColor"/><path d="M116 62L122 69M27 30H48M27 38H42M30 92H50M30 100H44M188 29H211M188 37H202M188 92H211M188 100H204" stroke="currentColor" stroke-opacity=".6"/>
                        <text x="85" y="109" fill="currentColor" font-size="9" font-family="monospace">find the source</text>
                      </svg>
                    )}
                  </div>
                  <h3>{p.data.title}</h3>
                </a>
                <p>{p.data.description}</p>
                <div class="project-meta">{p.data.sample && <span class="sample-label">示例档案</span>}<code>{p.data.tags.filter(t => t !== "示例").slice(0, 2).join(" / ")}</code></div>
              </article>
            ))}
          </div>
        </section>
        <section class="note-section" aria-labelledby="notes-title">
          <div class="section-heading"><h2 id="notes-title">最近写下</h2><a class="quiet-link" href={url("posts")}>全部笔记</a></div>
          <ul class="note-rows">{notes.map(p => (
            <li class="note-row">
              <div><h3><a href={getPostUrl(p.id, p.filePath, "zh")}>{p.data.title}</a></h3><p>{p.data.sample ? "示例笔记 / " : ""}{p.data.description}</p></div>
              <time datetime={p.data.pubDatetime.toISOString()}>{new Intl.DateTimeFormat("zh-CN", {month:"2-digit", day:"2-digit", timeZone:"Asia/Shanghai"}).format(p.data.pubDatetime)}</time>
            </li>
          ))}</ul>
        </section>
      </div>
      <aside class="study-aside" aria-label="书房侧记">
        <section class="aside-section"><h2>关于这间书房</h2><p>作品是动手的结果，笔记是思考的痕迹。这里让两者放在一起，也容得下还没想明白的部分。</p><a class="quiet-link" href={url("about")}>认识这里</a></section>
        <section class="aside-section"><h2>技能手册</h2><ul class="skill-list">{skills.map(p => <li><a href={getPostUrl(p.id, p.filePath, "zh")}>{p.data.title}</a><small>{p.data.sample ? "示例 / " : ""}{p.data.description}</small></li>)}</ul><a class="quiet-link" href={url("skills")}>打开手册</a></section>
        <section class="aside-section aside-note"><p>先留下问题，<br />再慢慢补上答案。</p></section>
      </aside>
    </div>
  </main>
  <Footer class="study-footer" />
</Layout>
