---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
const skills = getSortedPosts(await getCollection("posts")).filter(p => p.data.kind === "skill");
---
<Layout title="技能手册 | 数字书房">
  <Header />
  <main id="main-content" class="app-layout collection-page">
    <p class="section-kicker">技能手册</p>
    <h1>把一次实践，变成下次的方法。</h1>
    <p class="collection-intro">每个条目都围绕用途、输入、操作和检查方法展开，便于查阅与复用。</p>
    <aside class="sample-notice">首版为示例技能说明，后续可替换为自己的 SKILL.md 和实践记录。</aside>
    <ul>{skills.map(p => <Card {...p} />)}</ul>
    <a class="quiet-link" href={getRelativeLocaleUrl("zh", "tags")}>按主题浏览全部内容</a>
  </main>
  <Footer />
</Layout>
